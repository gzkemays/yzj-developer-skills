+# 轻量 frontmatter 读取（刻意不做完整 YAML 校验）：只认文件开头 '---' 包围块内的字段，
+# 正文里的 name:/description:（如代码示例）不作数。输出 "name<TAB>descok"：
+# name 已剥双引号与首尾空白；descok=1 表示 description 存在且值非空（内联值，或块标量的后续缩进行）
+read_fm () {
+  awk '
+    NR==1 { sub(/^\xef\xbb\xbf/,""); if ($0 !~ /^---\r?$/) exit; next }
+    /^---\r?$/ { exit }
+    {
+      line=$0; sub(/\r$/,"",line)
+      if (line ~ /^name:/) { v=line; sub(/^name:[[:space:]]*/,"",v); gsub(/^["]|["]$/,"",v); gsub(/[[:space:]]+$/,"",v); name=v; waiting=0 }
+      else if (line ~ /^description:/) {
+        v=line; sub(/^description:[[:space:]]*/,"",v); gsub(/[[:space:]]+$/,"",v); gsub(/^["]|["]$/,"",v)
+        if (v != "" && v != ">" && v != "|" && v != ">-" && v != "|-") desc=1; else waiting=1
+      }
+      else if (line ~ /^[[:space:]]+[^[:space:]]/) { if (waiting) { desc=1; waiting=0 } }
+      else { waiting=0 }
+    }
+    END { printf "%s\t%d", name, desc+0 }
+  ' "$1"
+}
